{
  "manifest_version": 3,
  "name": "Text Extractor",
  "version": "1.1.1",
  "description": "Crawl a web page or an entire website and export all of its text as one structured Markdown file.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "action": {
    "default_title": "Text Extractor",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "background": {
    "scripts": ["lib/defaults.js", "lib/html2md.js", "background.js"]
  },
  "permissions": ["activeTab", "scripting", "storage", "downloads", "tabs", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "browser_specific_settings": {
    "gecko": {
      "id": "text-extractor@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
